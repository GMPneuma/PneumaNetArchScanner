<section class="ap-scanner-body">
  <header class="ap-header"><strong>{{sceneName}}</strong>{{#if hasResult}}<span class="ap-result">Scanner check: {{result}}</span>{{/if}}</header>
  {{#if hasRollCard}}<section class="ap-roll-preview" aria-label="Scanner roll"><div class="ap-roll-card chat-log" aria-live="polite">Loading Scanner roll…</div></section>{{/if}}
  <div class="ap-filters">
    <label>Netrunner token<select name="runner"><option value="">Choose Netrunner…</option>{{#each runners}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    <label>Filter by Radius ({{units}})<input type="number" name="radius" value="{{radius}}" min="0" step="any"></label>
  </div>
  <label class="ap-scene-color">Unassigned AP color<input type="color" name="unassignedColor" value="{{unassignedColor}}" title="Color for unassigned APs on this scene"></label>
  <label class="ap-player-owned"><input type="checkbox" name="playerOwnedOnly" {{#if playerOwnedOnly}}checked{{/if}}> Show only player-owned tokens</label>
  <p class="notes">Zero lists all APs. Radius uses the scene’s grid measurement rules from the Netrunner; the GM decides what Scanner discovers.</p>
  {{#if runnerMissing}}<p class="ap-hint">Choose a Netrunner for distances and private reveals.</p>{{/if}}
  <div class="ap-selection-tools"><button type="button" data-action="select-visible">Select All Shown</button><button type="button" data-action="clear">Clear Selection</button><span class="ap-selection-count">{{selectedCount}} selected</span></div>
  <div class="ap-list-header" aria-label="Access point column headers"><table class="ap-control-table {{#unless showRevealAll}}ap-hide-reveal-all{{/unless}}"><colgroup><col class="ap-col-select"><col class="ap-col-name"><col class="ap-col-net"><col class="ap-col-distance"><col>{{#each bulkControls}}<col class="ap-col-toggle">{{/each}}</colgroup><thead><tr><th aria-label="Select"></th><th>Access Point</th><th>NetArch</th><th>Distance<br>({{units}})</th><th>Revealed to</th><th class="ap-toggle">Reveal to<br>Netrunner</th>{{#if showRevealAll}}<th class="ap-toggle">Reveal<br>to all</th>{{/if}}<th class="ap-toggle">{{pulseLabel}}</th><th class="ap-toggle">Pulse<br>forever</th><th class="ap-toggle">Show<br>AP name</th></tr></thead></table></div>
  <div class="ap-list">
    <table class="ap-control-table {{#unless showRevealAll}}ap-hide-reveal-all{{/unless}}"><colgroup><col class="ap-col-select"><col class="ap-col-name"><col class="ap-col-net"><col class="ap-col-distance"><col>{{#each bulkControls}}<col class="ap-col-toggle">{{/each}}</colgroup>

      <tbody>{{#each rows}}<tr {{#unless visible}}hidden{{/unless}}>
        <td><input type="checkbox" data-ap-select="{{id}}" aria-label="Select {{name}}" {{#if selected}}checked{{/if}}></td>
        <td><div class="ap-name-edit"><button type="button" class="ap-icon-button" data-action="edit" data-ap-id="{{id}}" title="Edit {{name}}" aria-label="Edit {{name}}"><i class="fas fa-pen-to-square"></i></button><button type="button" class="ap-name-button" data-action="locate" data-ap-id="{{id}}" title="Locate on scene">{{name}}</button></div><small>{{type}}</small></td>
        <td><span class="ap-swatch" style="background-color: {{color}}"></span>{{netarch}}</td>
        <td class="ap-distance">{{distanceText}}</td><td>{{status}}</td>
        {{#each controls}}<td class="ap-toggle"><input type="checkbox" data-control="{{key}}" data-group="{{group}}" data-ap-id="{{apId}}" aria-label="{{label}}: {{name}}" {{#if checked}}checked{{/if}}></td>{{/each}}
      </tr>{{/each}}</tbody>
    </table>
    {{#unless hasRows}}<p class="ap-empty">Drag an AP template from the Actors folder onto this scene to begin.</p>{{/unless}}
  </div>
  <footer class="ap-bulk-bar" aria-label="Bulk access point controls">
    <div class="ap-bulk-label"><strong>Apply to selected</strong><button type="button" data-action="apply" {{#unless canApply}}disabled{{/unless}}>Apply</button></div>
    {{#each bulkControls}}<label><input type="checkbox" data-control="{{key}}" data-group="{{group}}" aria-label="{{label}} for selected access points" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}
  </footer>
  <p class="notes">{{visibleCount}} of {{totalCount}} APs in the radius filter. Row changes apply immediately. Uncheck to hide or stop. A dash means selected APs differ; Apply changes only the options you adjust.</p>
  <p class="notes">Pulses use the audience in module settings and are visible only to players who can see the AP.</p>
</section>
